# Optional LLM provider config. Keep real keys in .env, not in code.
# rule / freellmapi / qwen / deepseek / zhipu / google / gemini / siliconflow / openai
TRAVEL_AGENT_LLM_PROVIDER=rule
TRAVEL_AGENT_LLM_API_KEY=
# FreeLLMAPI local router defaults (use the unified key from its dashboard):
# TRAVEL_AGENT_LLM_PROVIDER=freellmapi
# TRAVEL_AGENT_LLM_API_KEY=freellmapi-your-unified-key
# TRAVEL_AGENT_LLM_BASE_URL=http://localhost:31415/v1
# TRAVEL_AGENT_LLM_MODEL=auto
# Docker/server installs can instead use TRAVEL_AGENT_LLM_PROVIDER=freellmapi-docker
# (default base URL: http://localhost:3001/v1).
# Qwen China region defaults:
# TRAVEL_AGENT_LLM_PROVIDER=qwen
# TRAVEL_AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# TRAVEL_AGENT_LLM_MODEL=qwen-plus
# Zhipu OpenAI-compatible defaults:
# TRAVEL_AGENT_LLM_PROVIDER=zhipu
# TRAVEL_AGENT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# TRAVEL_AGENT_LLM_MODEL=glm-4.7-flash
# Google Gemini API (key from Google AI Studio):
# TRAVEL_AGENT_LLM_PROVIDER=google
# GEMINI_API_KEY=your-gemini-api-key
# 也可以使用通用变量 TRAVEL_AGENT_LLM_API_KEY
# TRAVEL_AGENT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# TRAVEL_AGENT_LLM_MODEL=gemini-2.5-flash
# SiliconFlow API (key from cloud.siliconflow.cn):
# TRAVEL_AGENT_LLM_PROVIDER=siliconflow
# SILICONFLOW_API_KEY=your-siliconflow-api-key
# TRAVEL_AGENT_LLM_BASE_URL=https://api.siliconflow.cn/v1
# TRAVEL_AGENT_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
TRAVEL_AGENT_LLM_BASE_URL=
TRAVEL_AGENT_LLM_MODEL=
TRAVEL_AGENT_LLM_TIMEOUT_SECONDS=20
TRAVEL_AGENT_LLM_TEMPERATURE=0.2
TRAVEL_AGENT_LLM_THINKING_ENABLED=false
TRAVEL_AGENT_LLM_REQUESTS_PER_SECOND=0

# Independent plan-quality Judge. Keep separate from the tested Agent model.
# Defaults to Google Gemini. TRAVEL_AGENT_JUDGE_API_KEY takes precedence;
# otherwise GEMINI_API_KEY / GOOGLE_API_KEY is used.
# FreeLLMAPI Desktop alternative (the unified key can stay provider-specific):
# TRAVEL_AGENT_JUDGE_PROVIDER=freellmapi
# FREELLMAPI_API_KEY=freellmapi-your-unified-key
# TRAVEL_AGENT_JUDGE_BASE_URL=http://localhost:31415/v1
# TRAVEL_AGENT_JUDGE_MODEL=auto
TRAVEL_AGENT_JUDGE_PROVIDER=google
TRAVEL_AGENT_JUDGE_API_KEY=
TRAVEL_AGENT_JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
TRAVEL_AGENT_JUDGE_MODEL=gemini-3.6-flash
TRAVEL_AGENT_JUDGE_TIMEOUT_SECONDS=60
TRAVEL_AGENT_JUDGE_TEMPERATURE=0
TRAVEL_AGENT_JUDGE_THINKING_ENABLED=false
# Gemini 3.6 Flash 项目配额 20 RPM；0.3 req/s = 18 RPM（预留 10%）。
TRAVEL_AGENT_JUDGE_REQUESTS_PER_SECOND=0.3
